DATABASE_URL=postgresql+psycopg://market:market-local@127.0.0.1:55433/market
FRONTEND_URL=http://localhost:3100
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Optional trusted-LAN demo: enable the override and add its dashboard origin above.
# COMPOSE_FILE=compose.yaml:compose.lan.yaml
# LAN_BIND_IP=192.168.1.50
# Set FRONTEND_URL=http://192.168.1.50:3100 for LAN approval links.
# Website provider sign-in requires HTTPS outside loopback; use passwords for LAN HTTP.
COOKIE_SECURE=false
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=market-local
MINIO_SECRET_KEY=market-local-storage-password
MINIO_BUCKET=market-products
DEMO_ENABLED=true
DEMO_PASSWORD=local-market-demo

# Optional website identity providers. Register exact FRONTEND_URL callbacks.
# See docs/identity.md. Keep secrets out of frontend variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_SIGNIN_CLIENT_ID=
OPENAI_SIGNIN_CLIENT_SECRET=
OPENAI_SIGNIN_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
